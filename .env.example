# ==============================================================================
# BRIGHT DATA WEB MCP CONFIGURATION
# ==============================================================================
# REQ: Paste your master API Key/Token found under Dashboard -> Settings -> Users & API keys
API_TOKEN=your_api_token_here

# REQ: Credentials for standard scraping integrations (Matches the credentials from your dashboard)
BRIGHT_DATA_API_KEY=your_bright_data_api_key_here
BRIGHT_DATA_USERNAME=brd-customer-xxxxxxxx-zone-mcp_unlocker
BRIGHT_DATA_PASSWORD=your_password_here

# OPTIONAL: Keep these standard defaults to maximize agent capabilities & protect credit balance
WEB_UNLOCKER_ZONE="mcp_unlocker"
PRO_MODE="true"
GROUPS="code,browser"
RATE_LIMIT="150/1h"

# ==============================================================================
# LLM & CLAUDE API CONFIGURATION
# ==============================================================================
ANTHROPIC_MODEL=claude-opus-4-7
TEMPERATURE=0.3

# ==============================================================================
# STREAMLIT CONFIGURATION
# ==============================================================================
STREAMLIT_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_LOGGER_LEVEL=info

# ==============================================================================
# SHIELDPROMPT CONFIGURATION
# ==============================================================================
DETECTION_THRESHOLD=0.85
AUTO_REMEDIATION_ENABLED=true
ESCALATION_THRESHOLD=0.95
LOG_LEVEL=INFO

# ==============================================================================
# DATABASE / STORAGE
# ==============================================================================
DATA_PATH=./data
LOG_PATH=./logs

# ==============================================================================
# THREAT INTELLIGENCE
# ==============================================================================
THREAT_INTEL_UPDATE_INTERVAL=3600
ENABLE_LIVE_SCRAPING=true

# ==============================================================================
# TIER 2: LLM SEMANTIC ANALYSIS
# ==============================================================================
ANTHROPIC_API_KEY=          # Claude Haiku — LLMEvaluator (~$0.001/scan)
OPENAI_API_KEY=             # text-embedding-3-small — VectorStore (~$0.00002/scan)
ENABLE_TIER2_SEMANTIC=true  # Master flag for Tier 2 (default: true)
LLM_MODEL=claude-haiku-4-5-20251001
EMBEDDING_MODEL=text-embedding-3-small

# Dev/offline mode: seed built-in mock patterns (no Bright Data keys needed)
USE_MOCK_PATTERNS=false

# ==============================================================================
# ACCESS-SURVIVAL / SNAPSHOTS  (see docs/SURVIVAL_PLAN.md)
# ==============================================================================
# Frozen intel bundles are written here and committed to git so harvested
# threat intel outlives Bright Data access.
SNAPSHOT_DIR=./snapshots
# Auto-load the warm cache (./data) on startup so harvested patterns persist.
AUTO_LOAD_ON_INIT=true
# Promote harvested high/critical pattern regexes into Tier 1 (needs no keys).
ENABLE_DYNAMIC_SIGNATURES=true
DYNAMIC_SIGNATURE_MIN_SEVERITY=high
